# Server environment: infrastructure only.
# API keys and model choices (OpenRouter, fal.ai, Pexels, LinkedIn, Meta, X) are managed in Admin → Integrations & keys
# and stored encrypted in MongoDB. Any key placed here is copied into the database once on first start, then ignored.

PORT=5000

# Core
MONGODB_URI=mongodb://127.0.0.1:27017/postera        # local dev: run `node scripts/dev-mongo.js`
JWT_SECRET=change_me_long_random

# Public URLs (needed for OAuth callbacks and for Facebook/Instagram to fetch images)
BACKEND_URL=https://your-backend.example.com
FRONTEND_URL=https://your-frontend.example.com        # comma-separated list allowed

# AI (OpenRouter) — one key for text + images
OPENROUTER_API_KEY=sk-or-v1-...
AI_TEXT_MODEL=openai/gpt-4o-mini                      # planning / captions
AI_SMART_MODEL=anthropic/claude-sonnet-4.6            # document summaries, image prompts
AI_IMAGE_MODEL=google/gemini-2.5-flash-image          # posters
MOCK_AI=0                                             # 1 = demo content without any API calls

# Video (fal.ai) — AI hero clip for post videos, Wan 2.2 5B image-to-video at $0.15 per clip. Without it videos still render (poster parallax + captions + music).
FAL_KEY=
VIDEO_HERO_MODEL=fal-ai/wan/v2.2-5b/image-to-video
AI_MUSIC_MODEL=google/lyria-3-clip-preview

# LinkedIn (Sign In with LinkedIn + Share on LinkedIn products)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook Page + Instagram Business (Meta app with pages_manage_posts, instagram_content_publish)
META_APP_ID=
META_APP_SECRET=

# X / Twitter (OAuth 2.0 app, redirect = BACKEND_URL/api/social/x/callback)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional
PEXELS_API_KEY=
ALLOW_ALL_ORIGINS=0
